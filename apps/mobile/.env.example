# The officer app uses the same public project credentials as apps/web.
# Supabase Dashboard -> Project Settings -> API / Connect
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# EAS project UUID used by Expo's push service. Replace before creating a dev build/APK.
EXPO_PUBLIC_EAS_PROJECT_ID=00000000-0000-0000-0000-000000000000

# Never place SUPABASE_SECRET_KEY, database passwords, or service-role keys here.
