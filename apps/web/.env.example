# Copy this file to .env.local before connecting authentication.

# Supabase Project Settings -> API / Connect
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Local website URL. Replace this with the Vercel URL after deployment.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional server-only credential for future trusted server operations.
# Never prefix this variable with NEXT_PUBLIC_ and never expose it to the browser.
SUPABASE_SECRET_KEY=

# Optional values used only by seed_user.mjs. Choose a strong temporary password.
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
SEED_USER_ROLE=officer
